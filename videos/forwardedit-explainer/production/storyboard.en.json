  "scenes": [
    {
      "id": "IntroScene",
      "title": "00 Introduction",
      "startFrame": 0,
      "durationInFrames": 300,
      "captions": [
        {
          "startFrame": 30,
          "endFrame": 150,
          "text": "The editor LLM reads real model weights and forward observations."
        },
        {
          "startFrame": 150,
          "endFrame": 300,
          "text": "ForwardEdit turns its explicit choices into local edits and inspectable evidence."
        }
      ]
    },
    {
      "id": "RolesScene",
      "title": "01 Roles",
      "startFrame": 300,
      "durationInFrames": 420,
      "captions": [
        {
          "startFrame": 300,
          "endFrame": 450,
          "text": "An external LLM chooses what to change and why, then calls tools through MCP."
        },
        {
          "startFrame": 450,
          "endFrame": 600,
          "text": "Tools execute the specified arithmetic on CPU. GPU use is inference only."
        },
        {
          "startFrame": 600,
          "endFrame": 720,
          "text": "No optimizer inside the tools selects or fits the new weights."
        }
      ]
    },
    {
      "id": "ObserveScene",
      "title": "02 Read and observe",
      "startFrame": 720,
      "durationInFrames": 480,
      "captions": [
        {
          "startFrame": 720,
          "endFrame": 870,
          "text": "Start with the execution contract, API schema, model and development-data settings."
        },
        {
          "startFrame": 870,
          "endFrame": 1020,
          "text": "Inspect actual modules, weight values and token-position observations."
        },
        {
          "startFrame": 1020,
          "endFrame": 1200,
          "text": "Compare signed contributions in failure and reference contexts before proposing a change."
        }
      ]
    },
    {
      "id": "HypothesisScene",
      "title": "03 Form a hypothesis",
      "startFrame": 1200,
      "durationInFrames": 420,
      "captions": [
        {
          "startFrame": 1200,
          "endFrame": 1350,
          "text": "State the numerical derivation, alternative explanations and a falsification condition."
        },
        {
          "startFrame": 1350,
          "endFrame": 1500,
          "text": "Missing evidence means defer. A prepared hypothesis permits a bounded causal probe."
        },
        {
          "startFrame": 1500,
          "endFrame": 1620,
          "text": "ready_for_causal_probe certifies neither causality nor performance."
        }
      ]
    },
    {
      "id": "WriteScene",
      "title": "04 Explicit CPU edit",
      "startFrame": 1620,
      "durationInFrames": 480,
      "captions": [
        {
          "startFrame": 1620,
          "endFrame": 1770,
          "text": "Here, the LLM explicitly chooses 0.120 → 0.110 at coordinate [0, 1]."
        },
        {
          "startFrame": 1770,
          "endFrame": 1920,
          "text": "The tool checks the source hash, current value and change budget before saving a candidate."
        },
        {
          "startFrame": 1920,
          "endFrame": 2100,
          "text": "This abbreviated call and these numbers are illustrative. No real model is edited."
        }
      ]
    },
    {
      "id": "FeedbackScene",
      "title": "05 Feedback and revision",
      "startFrame": 2100,
      "durationInFrames": 360,
      "captions": [
        {
          "startFrame": 2100,
          "endFrame": 2220,
          "text": "Use development data to check the intended effect and damage to normal cases."
        },
        {
          "startFrame": 2220,
          "endFrame": 2340,
          "text": "Read actual parent-candidate feedback before revising or restoring values."
        },
        {
          "startFrame": 2340,
          "endFrame": 2460,
          "text": "Preserve lineage and old/new values. No loss fitting or coordinate/strength sweeps."
        }
      ]
    },
    {
      "id": "ConfirmationScene",
      "title": "06 Freeze and confirm",
      "startFrame": 2460,
      "durationInFrames": 360,
      "captions": [
        {
          "startFrame": 2460,
          "endFrame": 2580,
          "text": "Finish development selection, then freeze the candidate and evaluation settings."
        },
        {
          "startFrame": 2580,
          "endFrame": 2700,
          "text": "Check effect, preservation and uncertainty on independent data."
        },
        {
          "startFrame": 2700,
          "endFrame": 2820,
          "text": "A correct weight write does not establish an independent task improvement."
        }
      ]
    },
    {
      "id": "RecapScene",
      "title": "07 Claims and limitations",
      "startFrame": 2820,
      "durationInFrames": 300,
      "captions": [
        {
          "startFrame": 2820,
          "endFrame": 2970,
          "text": "ForwardEdit separates judgment, execution and verification, and retains the evidence."
        },
        {
          "startFrame": 2970,
          "endFrame": 3120,
          "text": "Every published study failed at least one declared acceptance criterion."
        }
      ]
    }
  ]
}
